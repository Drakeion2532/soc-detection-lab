<!--
  SOC detection lab: custom Wazuh rules for Sysmon events from a Windows agent.
  Copy into /var/ossec/etc/rules/local_rules.xml on the manager (or merge with what is there),
  then restart the manager. Check each one with:  /var/ossec/bin/wazuh-logtest
  IDs 100100-100199 are reserved for this lab.
-->
<group name="soc_lab,sysmon,">

  <!-- T1059.001: PowerShell with an encoded command (Sysmon Event ID 1) -->
  <rule id="100101" level="10">
    <if_group>sysmon_event1</if_group>
    <field name="win.eventdata.image" type="pcre2">(?i)\\(powershell|pwsh)\.exe$</field>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)\s-(e|ec|enc|encodedcommand)\s</field>
    <description>SOC lab: PowerShell started with an encoded command</description>
    <mitre><id>T1059.001</id></mitre>
  </rule>

  <!-- T1053.005: scheduled task created with schtasks.exe -->
  <rule id="100102" level="8">
    <if_group>sysmon_event1</if_group>
    <field name="win.eventdata.image" type="pcre2">(?i)\\schtasks\.exe$</field>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)/create</field>
    <description>SOC lab: scheduled task created from the command line</description>
    <mitre><id>T1053.005</id></mitre>
  </rule>

  <!-- T1136.001: local account added with net.exe / net1.exe -->
  <rule id="100103" level="12">
    <if_group>sysmon_event1</if_group>
    <field name="win.eventdata.image" type="pcre2">(?i)\\net1?\.exe$</field>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)\suser\s.*/add</field>
    <description>SOC lab: local user account created from the command line</description>
    <mitre><id>T1136.001</id></mitre>
  </rule>

  <!-- T1547.001: value written under a Run / RunOnce key (Sysmon Event ID 13) -->
  <rule id="100104" level="10">
    <if_group>sysmon_event_13</if_group>
    <field name="win.eventdata.targetObject" type="pcre2">(?i)\\Software\\Microsoft\\Windows\\CurrentVersion\\Run(Once)?\\</field>
    <description>SOC lab: registry Run key persistence</description>
    <mitre><id>T1547.001</id></mitre>
  </rule>

  <!-- T1033 / T1082: one discovery tool (base event, low level) -->
  <rule id="100105" level="3">
    <if_group>sysmon_event1</if_group>
    <field name="win.eventdata.image" type="pcre2">(?i)\\(whoami|systeminfo|hostname|ipconfig|net|quser)\.exe$</field>
    <description>SOC lab: discovery tool executed</description>
    <mitre><id>T1033</id></mitre>
  </rule>

  <!-- three discovery events from the same host within 5 minutes -->
  <rule id="100106" level="8" frequency="3" timeframe="300">
    <if_matched_sid>100105</if_matched_sid>
    <same_field>win.eventdata.parentProcessId</same_field>
    <description>SOC lab: burst of discovery commands from one parent process</description>
    <mitre><id>T1033</id><id>T1082</id></mitre>
  </rule>

</group>
